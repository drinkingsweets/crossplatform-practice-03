{
  "name": "electron-file-explorer",
  "version": "1.0.0",
  "description": "Практическая работа 3: просмотр каталога и версии runtime, вариант 8",
  "author": "Власенко Марк Евгеньевич, ТРПО23-3",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "node --test tests/*.test.js"
  },
  "build": {
    "appId": "ru.fa.vlasenko.fileexplorer",
    "productName": "Electron File Explorer",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "directory.js",
      "index.html",
      "styles.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "example",
        "to": "example"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
